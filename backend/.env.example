# Commit: "feat(api): configuración desde variables de entorno"
# ═══════════════════════════════════════════════════════════════════
# Copia este archivo como .env y llena tus valores. El .env real NUNCA se sube a GitHub.

# Puerto de la API (http://localhost:3000/api)
PORT=3000

# Cadena de conexión de Supabase (Connect → Connection string → Session pooler).
# Reemplaza [YOUR-PASSWORD] por la contraseña de la base. Se comparte solo por mensaje privado.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Supabase exige conexión cifrada: true. Para un PostgreSQL local sin SSL: false.
DB_SSL=true

# Dirección del Front-End que puede llamar a la API (Vite usa el puerto 5173).
CORS_ORIGEN=http://localhost:5173
